# Copiar a .env y completar. El archivo .env no se versiona.

# Base de datos. Si DB_URL está vacío se usa SQLite (database/etl_corea.sqlite).
# PostgreSQL (recomendado por el profesor):
#   DB_URL=postgresql+psycopg://postgres:CLAVE@localhost:5432/etl_corea
DB_URL=

# UN World Population Prospects (opcional, sólo contraste). Token gratuito:
# https://population.un.org/dataportalapi/token/index.html
UNWPP_API_TOKEN=

# World Bank y OECD no requieren credenciales.
# KOSIS no se usa por API (restringida a residentes de Corea): ver README, sección "Fuentes".
