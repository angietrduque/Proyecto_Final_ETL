	</Cell>	
	</Row>	
	<Row ss:AutoFitHeight="0" ss:Height="12">	
	<Cell> 	
	<Data ss:Type="String">○Source</Data>	
	</Cell>	
	<Cell> 	
	<Data ss:Type="String">KOSIS(Source: Ministry of Data and Statistics, Population Census), 2026.10.02 09:47 </Data>	
	</Cell>	
	</Row>	
	<Row ss:AutoFitHeight="0" ss:Height="12">	
	<Cell> 	
	<Data ss:Type="String">○Table URL</Data>	
	</Cell>	
	<Cell> 	
	<Data ss:Type="String">https://kosis.kr/statHtml/statHtml.do?orgId=101&tblId=DT_1IN1502&language=en&conn_path=I3</Data>	
	</Cell>	
	</Row>	
	<Row ss:AutoFitHeight="0" ss:Height="12">	
	<Cell> 	
	<Data ss:Type="String"></Data>	
	</Cell>	
	<Cell> 	
	<Data ss:Type="String">* The URL for a statistical table may change in case of the KOSIS revision.</Data>	
	</Cell>	
	</Row>	
	<Row ss:AutoFitHeight="0" ss:Height="12">	
	<Cell> 	
	<Data ss:Type="String">○Comment</Data>	
	</Cell>	
	</Row>	
	<Row ss:AutoFitHeight="0" ss:Height="12">	
	<Cell> 	
	<Data ss:Type="String"></Data>	
	</Cell>	
	<Cell> 	
	<Data ss:Type="String">TABLE : 주1) Total Population (Including Foreigners)"</Data>	
	</Cell>	
	</Row>	
	<Row ss:AutoFitHeight="0" ss:Height="12">	
	<Cell> 	
	<Data ss:Type="String"></Data>	
	</Cell>	
	<Cell> 	
	<Data ss:Type="String">          "</Data>	
	</Cell>	
	</Row>	
	<Row ss:AutoFitHeight="0" ss:Height="12">	
	<Cell> 	
	<Data ss:Type="String"></Data>	
	</Cell>	
	<Cell> 	
	<Data ss:Type="String">         주2) Type of Household"</Data>	
	</Cell>	
	</Row>	
	<Row ss:AutoFitHeight="0" ss:Height="12">	
	<Cell> 	
	<Data ss:Type="String"></Data>	
	</Cell>	
	<Cell> 	
	<Data ss:Type="String">            - Ordinary Household (Type of Household ①-④, includes foreigners in ordinary households)"</Data>	
	</Cell>	
	</Row>	
	<Row ss:AutoFitHeight="0" ss:Height="12">	
	<Cell> 	
	<Data ss:Type="String"></Data>	
	</Cell>	
	<Cell> 	
	<Data ss:Type="String">             · One person household"</Data>	
	</Cell>	
	</Row>	
	<Row ss:AutoFitHeight="0" ss:Height="12">	
	<Cell> 	
	<Data ss:Type="String"></Data>	
	</Cell>	
	<Cell> 	
	<Data ss:Type="String">             · Household consisting of a family and five or less non-family members"</Data>	
	</Cell>	
	</Row>	
	<Row ss:AutoFitHeight="0" ss:Height="12">	
	<Cell> 	
	<Data ss:Type="String"></Data>	
	</Cell>	
	<Cell> 	
	<Data ss:Type="String">             · Household of five or less persons who have no blood ties"</Data>	
	</Cell>	
	</Row>	
	<Row ss:AutoFitHeight="0" ss:Height="12">	
	<Cell> 	
	<Data ss:Type="String"></Data>	
	</Cell>	
	<Cell> 	
	<Data ss:Type="String">            - Group Household"</Data>	
	</Cell>	
	</Row>	
	<Row ss:AutoFitHeight="0" ss:Height="12">	
	<Cell> 	
	<Data ss:Type="String"></Data>	
	</Cell>	
	<Cell> 	
	<Data ss:Type="String">             · Household of six or more persons who have no blood ties: (Type of Household ⑤)"</Data>	
	</Cell>	
	</Row>	
	<Row ss:AutoFitHeight="0" ss:Height="12">	
	<Cell> 	
	<Data ss:Type="String"></Data>	
	</Cell>	
	<Cell> 	
	<Data ss:Type="String">             · Group Facility Household: Household residing in dormitories or welfare institutions such as nursing homes "</Data>	
	</Cell>	
	</Row>	
	<Row ss:AutoFitHeight="0" ss:Height="12">	
	<Cell> 	
	<Data ss:Type="String"></Data>	
	</Cell>	
	<Cell> 	
	<Data ss:Type="String">            - Foreigner Household: households composed of foreigners"</Data>	
	</Cell>	
	</Row>	
