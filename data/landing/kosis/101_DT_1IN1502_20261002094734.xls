	<Cell> 	
	<Data ss:Type="String">○Table ID</Data>	
	</Cell>	
	<Cell> 	
	<Data ss:Type="String">DT_1IN1502</Data>	
	</Cell>	
	</Row>	
	<Row ss:AutoFitHeight="0" ss:Height="12">	
	<Cell> 	
	<Data ss:Type="String">○Table Name</Data>	
	</Cell>	
	<Cell> 	
	<Data ss:Type="String">Population, Households and Housing Units</Data>	
	</Cell>	
	</Row>	
